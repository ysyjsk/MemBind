{
  "schema_version": "membind.routing-policy.v1",
  "profile_id": "local-qwen3-8b-awq-dualreplica-v1",
  "arm": "V6_1_8B_DUAL_EDGE_CALL_AFFINITY",
  "formal_role": "autoresearch_candidate",
  "endpoint_set": [
    {
      "id": "native-replica",
      "base_url": "http://127.0.0.1:18200/v1",
      "served_model": "qwen3-8b-awq",
      "physical_gpu": 0
    },
    {
      "id": "prepare-replica",
      "base_url": "http://127.0.0.1:18201/v1",
      "served_model": "qwen3-8b-awq",
      "physical_gpu": 1
    }
  ],
  "router": {
    "policy": "semantic_phase_edge_call_affinity",
    "phase_labels_visible": true,
    "work_conserving": true,
    "spillover": "idle_replica_only_on_first_edge_page",
    "bindings": {
      "PREPARE.edge": "first-elastic-choice-then-pinned",
      "NATIVE.edge": "first-elastic-choice-then-pinned",
      "other": "existing-elastic-phase-affinity"
    },
    "handoff_payload": "exact-extraction-transcript-no-kv-transfer",
    "selection_evidence": "logical-edge-group-acquire-release"
  },
  "constraints": {
    "same_prompt_and_decoding_contract": true,
    "same_endpoint_set_as_native": true,
    "same_embedding_endpoint_as_native": true,
    "authoritative_publication_only_in_native_phase": true,
    "only_extract_edges_edge_is_pinned": true,
    "first_page_uses_existing_elastic_choice": true,
    "continuations_keep_logical_call_endpoint": true
  }
}
