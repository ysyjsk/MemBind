{
  "schema_version": "membind.routing-policy.v1",
  "profile_id": "local-qwen3-8b-awq-dualreplica-v1",
  "arm": "V6_1_8B_DUAL_FRONTIER_CRITICAL_PATH_RESOURCE_SCHEDULER",
  "formal_role": "autoresearch_candidate",
  "endpoint_set": [
    {
      "id": "native-replica",
      "base_url": "http://127.0.0.1:18200/v1",
      "served_model": "qwen3-8b-awq",
      "physical_gpu": 0
    },
    {
      "id": "prepare-replica",
      "base_url": "http://127.0.0.1:18201/v1",
      "served_model": "qwen3-8b-awq",
      "physical_gpu": 1
    }
  ],
  "router": {
    "policy": "frontier_critical_path_resource_scheduler_v1",
    "phase_labels_visible": true,
    "work_conserving": true,
    "spillover": "critical_path_earliest_finish",
    "capacity_source": "observed_endpoint_identity_and_measured_service_ewma",
    "work_estimate_source": "admitted_request_tokens_and_service_duration",
    "critical_path_source": "durable_frontier_phase_and_ready_task_slack",
    "bindings": {
      "PREPARE": "prepare-replica",
      "NATIVE": "native-replica"
    },
    "tie_break": "frontier_critical_then_preferred_endpoint_then_endpoint_id",
    "handoff_payload": "exact_extraction_transcript_no_kv_transfer",
    "selection_evidence": "candidate_finish_scores_and_service_ewma"
  },
  "constraints": {
    "same_prompt_and_decoding_contract": true,
    "same_endpoint_set_as_native": true,
    "same_embedding_endpoint_as_native": true,
    "authoritative_publication_only_in_native_phase": true,
    "request_tokens_from_shared_admission": true,
    "service_estimates_from_observed_calls": true,
    "ordered_publication_unchanged": true,
    "no_private_capacity_or_lane_change": true
  }
}
